+-- Allows approved admins to remove images from the site-images bucket
+-- (needed for the "delete image" / "delete product" buttons in the editor).
+drop policy if exists "Approved admins can delete site images" on storage.objects;
+create policy "Approved admins can delete site images"
+on storage.objects for delete to authenticated
+using (
+  bucket_id = 'site-images'
+  and exists (select 1 from public.admin_users where user_id = auth.uid())
+);
